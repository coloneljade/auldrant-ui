{
  "name": "@auldrant/ui",
  "version": "2.3.0",
  "type": "module",
  "description": "Accessible Preact component library with design tokens and CSS modules",
  "author": "Colonel Jade",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coloneljade/auldrant-ui.git"
  },
  "homepage": "https://github.com/coloneljade/auldrant-ui",
  "bugs": "https://github.com/coloneljade/auldrant-ui/issues",
  "keywords": [
    "preact",
    "components",
    "ui",
    "component-library",
    "accessibility",
    "a11y",
    "css-modules",
    "design-tokens",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "import": "./dist/signals/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/auldrant-ui.css",
      "default": "./dist/auldrant-ui.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICES",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc && tsc-alias",
    "build:types": "tsc && tsc-alias",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "format": "biome format --fix .",
    "lint": "biome lint .",
    "test": "bun test",
    "test:a11y": "bun test tests/a11y/",
    "test:watch": "bun test --watch",
    "licenses": "bun run scripts/check-licenses.ts",
    "licenses:fix": "bun run scripts/check-licenses.ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "dev": "vite --host",
    "prepare": "test -n \"$CI\" || git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@happy-dom/global-registrator": "^20.9.0",
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.0",
    "@testing-library/preact": "^3.2.4",
    "@types/bun": "^1.3.12",
    "axe-core": "^4.11.3",
    "culori": "^4.0.2",
    "preact": "^10.29.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "vite": "^8.0.9"
  },
  "peerDependencies": {
    "@preact/signals": "^2.8.1",
    "preact": "^10.28.4"
  },
  "dependencies": {
    "lucide-preact": "^1.8.0"
  }
}
