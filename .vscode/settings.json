{
	"editor.formatOnType": true,
	"editor.formatOnSave": true,
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.biome": "explicit"
		}
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.biome": "explicit"
		}
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[markdown]": {
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll.markdownlint": "explicit"
		}
	},
	"files.exclude": {
		"**/.git": true,
		"**/node_modules": true,
		"**/dist": true
	},
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,
	"cSpell.ignorePaths": ["devcontainer.json", "biome.json", "bun.lock"],
	"cSpell.words": ["Auldrant", "biomejs", "preact", "lefthook", "storybook", "vite"],
	"github.gitProtocol": "ssh",
	"search.exclude": {
		"**/.git": true,
		"**/node_modules": true,
		"**/dist": true,
		"bun.lock": true,
		"storybook-static": true
	}
}
